{
  "name": "@speca11y/cli",
  "version": "0.5.1",
  "description": "CLI for SpecA11y - automated WCAG accessibility checker",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "speca11y": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm build && node --test __tests__/*.test.mjs && node ../../scripts/check-package-surface.mjs .",
    "lint": "node ../../scripts/lint-typescript.mjs src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@speca11y/core": "workspace:*",
    "@speca11y/semantic": "workspace:*",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
